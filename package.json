{
  "name": "node-typescript-template",
  "version": "1.0.0",
  "private": true,
  "description": "Base técnica para servicios Node.js con TypeScript",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && pnpm --filter web build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && pnpm --filter web typecheck",
    "test": "vitest run && pnpm --filter web test",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.lint.json && pnpm --filter web lint",
    "dev:web": "pnpm --filter web dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:preview": "node scripts/dev-preview.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "template": {
    "name": "node-typescript",
    "version": "1.8.0"
  }
}
