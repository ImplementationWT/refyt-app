NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB (required). In production the platform injects these values.
# `pnpm dev:local` fills them in for the local MongoDB of compose.yaml:
#   mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MONGODB_URI=
# Must match ^client_[a-z0-9_]+$, e.g.: client_local
MONGODB_DB=

# Sessions (required): at least 32 random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Password for the initial "admin" user (min. 10 characters).
# If empty, the development default "admin123" is used and must be changed
# on first login.
INITIAL_ADMIN_PASSWORD=
# Optional. Name shown in the UI (exposed by GET /api/meta).
APP_DISPLAY_NAME=
# Optional (true by default). Can only be false outside production.
# FORCE_ADMIN_PASSWORD_CHANGE=true

# Optional integrations. Without them the app works the same.
# Monday.com API token (its boards are those visible to the token's owner).
MONDAY_API_TOKEN=
# Will Doo, the co-pilot: off (hidden), basic (quick queries without AI, the default)
# or claude (chat with Claude, needs ANTHROPIC_API_KEY).
# WILL_DOO_MODE=basic
# Anthropic API key of the client's own account (each project its own).
ANTHROPIC_API_KEY=
# WILL_DOO_MODEL=claude-sonnet-5-5
# Monthly spend cap of the whole app (USD, Anthropic list price).
# WILL_DOO_MONTHLY_BUDGET_USD=50
# WILL_DOO_USER_DAILY_MESSAGES=100
# Days a conversation is kept after its last message.
# WILL_DOO_RETENTION_DAYS=90

# Optional tuning (defaults shown)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_STARTUP_RETRIES=8
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# TRUST_PROXY_HOPS=1
# MONDAY_MAX_BOARDS=500
